{
    "name": "azt3k/silverstripe-twig",
    "type": "silverstripe-vendormodule",
    "description": "Allows use of twig in SilverStripe 6",
    "license": "MIT",
    "authors": [
        {
            "name": "Cam Spiers",
            "email": "cameron@heyday.co.nz",
            "role": "Developer"
        },
        {
            "name": "Az Ilari",
            "email": "az@dev-io.us",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "silverstripe/framework": "^6.0",
        "silverstripe/admin": "^3.0",
        "silverstripe/vendor-plugin": "^3.0",
        "twig/twig": "^3.14",
        "pimple/pimple": "~3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.0",
        "silverstripe/recipe-cms": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Azt3k\\SS\\Twig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Azt3k\\SS\\Twig\\Tests\\": "tests/"
        },
        "classmap": [
            "app/src/Page.php",
            "app/src/PageController.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "silverstripe/recipe-plugin": true
        }
    }
}
